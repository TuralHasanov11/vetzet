{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Integrated Browser web-app",
      "request": "launch",
      "type": "editor-browser",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/src/web-app/app"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Containers: Attach to Node web-app",
      "remoteRoot": "${workspaceFolder}/src/web-app"
    },
    {
      "name": "Containers: Node.js Launch web-app",
      "type": "docker",
      "request": "launch",
      "preLaunchTask": "docker-run: debug web-app",
      "platform": "node",
      "node": {
        "package": "${workspaceFolder}/src/web-app/package.json",
        "localRoot": "${workspaceFolder}/src/web-app"
      }
    }
  ],
  "compounds": [
    {
      "name": "fullstack: nuxt web-app",
      "configurations": ["Containers: Attach to Node web-app", "Launch Integrated Browser web-app"]
    }
  ]
}
